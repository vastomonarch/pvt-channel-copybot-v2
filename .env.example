# ============================================================================
# Telegram Private Channel Copy Bot — environment configuration
# Copy to `.env` and fill in.  NEVER commit the real `.env`.
# ============================================================================

# ── Telegram API credentials (required) ────────────────────────────────────
# Get them from https://my.telegram.org/apps
API_ID=12345678
API_HASH=your_api_hash_here

# ── Bot token for live progress updates (optional) ─────────────────────────
# Create a bot with @BotFather and paste the token here.  Without it the
# progress dashboard is edited in the command chat instead of a dedicated
# bot chat.
BOT_TOKEN=your_bot_token_here

# ── Default destination channel (optional) ─────────────────────────────────
# Used when config.json does not exist yet.  You can also add/switch
# destinations at runtime with .adest and .showdest.
DESTINATION=-1001234567890

# ── Directories (optional — defaults are relative to the project root) ────
# DATA_DIR holds everything the bot writes: TDLib sessions/databases,
# checkpoint DB, logs.  STAGING_DIR holds in-flight downloads.
# DATA_DIR=./data
# STAGING_DIR=./_pvtcopydl_tmp

# ── TDLib native library (optional) ────────────────────────────────────────
# Leave unset to auto-resolve (system lib → bundled wheel → ./tdlib/lib).
# TDLIB_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu/libtdjson.so
# Native TDLib log (0=fatal … 4=debug); file defaults to data/logs/tdlib_native.log
# TDLIB_LOG_VERBOSITY=1
# TDLIB_LOG_FILE=
# Optional database encryption key (TDLib database_encryption_key)
# TDLIB_DB_KEY=

# ── Concurrency / limits (optional — sane defaults shown) ──────────────────
# Parallel file transfers (semaphores shared across ALL running jobs)
# MAX_CONCURRENT_DOWNLOADS=3
# MAX_CONCURRENT_UPLOADS=2
# How many copy jobs may run at once / wait in the queue
# MAX_RUNNING_JOBS=2
# MAX_QUEUED_JOBS=8
# Retries per message for transient errors (exponential backoff + jitter)
# RETRY_COUNT=4

# ── Timeouts (seconds) ─────────────────────────────────────────────────────
# REQUEST_TIMEOUT=60            # generic TDLib request
# SEND_TIMEOUT=1800             # message send / large upload
# DOWNLOAD_STALL_TIMEOUT=300    # no-progress watchdog per download
# SHUTDOWN_TIMEOUT=20           # graceful shutdown budget on SIGTERM

# ── Progress / behaviour ───────────────────────────────────────────────────
# Minimum seconds between progress edits (Telegram allows ~20 edits/min)
# PROGRESS_EDIT_INTERVAL=2.5
# Message fetch window used when resolving albums
# ALBUM_WINDOW=15
# Messages downloaded ahead of the upload queue
# PREFETCH_DEPTH=6
# Refuse to upload a single file above this (Telegram's hard cap is 2 GB)
# MAX_SINGLE_FILE_BYTES=1992294400
# 1 = re-read and hash-verify split parts before the original is deleted
# SPLIT_VERIFY_HASH=0

# ── Misc ───────────────────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Names used if TDLib asks to register a brand-new account
# REGISTER_FIRST_NAME=Copy
# REGISTER_LAST_NAME=
