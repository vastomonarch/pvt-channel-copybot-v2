# Telegram API credentials
# Get these from https://my.telegram.org/apps
API_ID=12345678
API_HASH=your_api_hash_here

# Bot token for live progress updates (optional)
# Create a bot via @BotFather and paste the token here
BOT_TOKEN=your_bot_token_here

# Default destination channel for copying (optional)
# Use your channel/group ID (e.g., -1001234567890)
# This is used if config.json doesn't exist or is empty.
# You can also add/switch destinations at runtime with .adest and .showdest
DESTINATION=-1001234567890

# Log level (optional): DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
